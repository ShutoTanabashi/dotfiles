{{- /* シークレット値取得の共通テンプレート(apply 時解決)。

     呼び出し例(必須キーは abortEmpty で未解決を検出):
       {{ includeTemplate "secret.tmpl" (dict "key" "github_token" "data" .) | abortEmpty }}

     引数:
       key     (必須) シークレットキー名
       data    (必須) 呼び出し側のテンプレートコンテキスト "."
       service (任意) keyring のサービス名 / gopass のプレフィックス。省略時は "dotfiles"
       backend (任意) 明示指定 ("gopass" / "keyring")。省略時は chezmoi.toml [data.secrets].backend、
               そこでも未指定なら自動判定(gopass インストール済みなら gopass、
               darwin / windows または secret-tool 検出時は OS keyring)

     取得先の登録方法:
       gopass:  gopass insert dotfiles/<key>
       keyring: chezmoi secret keyring set --service=dotfiles --user=<key>

     注意:
       テンプレート名は .chezmoitemplates/ 内の相対パス(拡張子込み)で指定する。
       値が登録されていない場合、gopass / keyring 関数がエラーになり apply が失敗する。
       複数行の値が必要な場合は本テンプレートでなく gopassRaw を直接使うこと。
*/ -}}
{{- $key := .key -}}
{{- $service := "dotfiles" -}}
{{- if hasKey . "service" -}}{{- $service = .service -}}{{- end -}}
{{- $backend := "" -}}
{{- if hasKey . "backend" -}}{{- $backend = .backend -}}{{- end -}}
{{- if and (eq $backend "") (hasKey .data "secrets") (hasKey .data.secrets "backend") -}}
{{-   $backend = .data.secrets.backend -}}
{{- end -}}
{{- if eq $backend "" -}}
{{-   if lookPath "gopass" -}}
{{-     $backend = "gopass" -}}
{{-   else if or (eq .data.chezmoi.os "darwin") (eq .data.chezmoi.os "windows") (lookPath "secret-tool") -}}
{{-     $backend = "keyring" -}}
{{-   end -}}
{{- end -}}
{{- if eq $backend "gopass" -}}
{{-   gopass (printf "%s/%s" $service $key) -}}
{{- else if eq $backend "keyring" -}}
{{-   keyring $service $key -}}
{{- else -}}
{{-   warnf "secret.tmpl: no backend available for %q (install gopass or use a desktop with Secret Service)" $key -}}
{{- end -}}
