# rclone gdrive remote の環境変数定義（chezmoi 生成）。
# client_id / client_secret は keyring から apply 時に secret.tmpl で解決される。
# token は rclone config でローカル生成される ~/.config/rclone/rclone.conf で管理（keyring 対象外）。
export RCLONE_CONFIG_GDRIVE_TYPE='drive'
export RCLONE_CONFIG_GDRIVE_CLIENT_ID='{{ includeTemplate "secret.tmpl" (dict "key" "rclone_gdrive_client_id" "data" .) }}'
export RCLONE_CONFIG_GDRIVE_CLIENT_SECRET='{{ includeTemplate "secret.tmpl" (dict "key" "rclone_gdrive_client_secret" "data" .) }}'
