{{- $role := promptStringOnce . "role" "role [desktop|server]" "desktop" -}}
{{- if and (ne $role "desktop") (ne $role "server") -}}
{{-   warnf "invalid role %q (expected desktop or server)" $role -}}
{{-   exit 1 -}}
{{- end -}}
{{- $variant := promptStringOnce . "variant" "variant [full|minimal]" "full" -}}
{{- if and (ne $variant "full") (ne $variant "minimal") -}}
{{-   warnf "invalid variant %q (expected full or minimal)" $variant -}}
{{-   exit 1 -}}
{{- end -}}
[data]
    role = {{ $role | quote }}
    variant = {{ $variant | quote }}
{{ if eq .chezmoi.os "linux" }}
{{ $goneovimExecutable := promptStringOnce . "goneovim.executable" "Goneovim executable path" "/usr/bin/goneovim" -}}
{{ $goneovimIconPath := promptStringOnce . "goneovim.icon_path" "Goneovim icon path" (printf "%s/.local/share/icons/goneovim.ico" .chezmoi.homeDir) }}

[data.goneovim]
    executable = {{ $goneovimExecutable | quote }}
    icon_path = {{ $goneovimIconPath | quote }}
{{ end }}
